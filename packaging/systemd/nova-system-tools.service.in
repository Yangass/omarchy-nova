[Unit]
Description=NOVA Read-Only System Tools
After=default.target

[Service]
Type=simple
WorkingDirectory=@NOVA_ROOT@/nova-system-tools
ExecStart=@PYTHON@ server.py
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
